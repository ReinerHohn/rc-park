{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/claude-mds-sync.sh\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$HOME/.claude/hooks/no_big_binaries.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
