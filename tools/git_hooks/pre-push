#!/bin/bash
# pre-push: alle neu zu pushenden Commits auf Zugangsdaten und Dateien > 95 MB pruefen (tools/git_hooks/geheim_pruefen.py).
cd "$(git rev-parse --show-toplevel)" || exit 1
rc=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$rsha" = "0000000000000000000000000000000000000000" ]; then spanne="$lsha --not --remotes"; else spanne="$rsha..$lsha"; fi
  python3 tools/git_hooks/geheim_pruefen.py --bereich "$spanne" || rc=1
done
exit $rc
